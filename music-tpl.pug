    script.
      (function() {
        // 1. Cấu trúc dữ liệu JSON nguồn
        let musicData = [
          {
            id: "playlist-1",
            name: "Top Thịnh Hành",
            tracks: [
              {
                id: "song_hash_001",
                title: "Giai Điệu Ánh Sáng",
                artist: "Artist A",
                duration: "", 
                art: [
                  { src: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=96&auto=format&fit=crop&q=60", sizes: "96x96", mimeType: "image/jpeg" },
                  { src: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=512&auto=format&fit=crop&q=60", sizes: "512x512", mimeType: "image/jpeg" }
                ],
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"
              },
              {
                id: "song_hash_002",
                title: "Hành Trình Mới",
                artist: "Artist B",
                duration: "4:12",
                art: "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=500&auto=format&fit=crop&q=60",
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3"
              },
              {
                id: "song_hash_003",
                title: "Khoảng Lặng",
                artist: "Artist C",
                duration: null,
                art: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=500&auto=format&fit=crop&q=60",
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3"
              }
            ]
          },
          {
            id: "playlist-2",
            name: "Lofi Chill",
            tracks: [
              {
                id: "song_hash_004",
                title: "Cà Phê Sáng Mưa",
                artist: "Lofi Gurl",
                duration: "3:10",
                art: "https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=500&auto=format&fit=crop&q=60",
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3"
              },
              {
                id: "song_hash_005",
                title: "Góc Phố Kỷ Niệm",
                artist: "Chill Maker",
                duration: "4:05",
                art: "https://images.unsplash.com/photo-1518609878373-06d740f60d8b?w=500&auto=format&fit=crop&q=60",
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3"
              }
            ]
          },
          {
            id: "playlist-3",
            name: "Remix Sôi Động",
            tracks: [
              {
                id: "song_hash_006",
                title: "Vũ Trụ Đêm Nay (Remix)",
                artist: "DJ Max",
                duration: "2:45",
                art: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=500&auto=format&fit=crop&q=60",
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3"
              },
              {
                id: "song_hash_007",
                title: "Bùng Nổ Đam Mê",
                artist: "DJ Z",
                duration: "3:20",
                art: "https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=500&auto=format&fit=crop&q=60",
                url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-7.mp3"
              }
            ]
          }
        ];

        let currentActivePlaylistId = "playlist-1";
        let currentTrackIndex = 0;
        let isPlaying = false;
        let isShuffle = false;
        let isRepeat = false;
        
        const audioElement = new Audio();

        function getTrackArtUrl(artData) {
          if (Array.isArray(artData) && artData.length > 0) {
            return artData[0].src;
          }
          return artData || "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=500&auto=format&fit=crop&q=60";
        }

        function getDynamicArtMetadata(artData, callback) {
          if (Array.isArray(artData) && artData.length > 0) {
            const formatted = artData.map(item => ({
              src: item.src,
              sizes: item.sizes || '512x512',
              type: item.mimeType || 'image/jpeg'
            }));
            callback(formatted);
            return;
          }

          const imgUrl = artData || "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=500&auto=format&fit=crop&q=60";
          const img = new Image();
          
          img.onload = function() {
            const width = img.naturalWidth || 512;
            const height = img.naturalHeight || 512;
            const sizeStr = `${width}x${height}`;
            
            let mimeType = 'image/jpeg';
            if (imgUrl.toLowerCase().endsWith('.png')) mimeType = 'image/png';
            else if (imgUrl.toLowerCase().endsWith('.webp')) mimeType = 'image/webp';
            else if (imgUrl.toLowerCase().endsWith('.gif')) mimeType = 'image/gif';

            callback([
              {
                src: imgUrl,
                sizes: sizeStr,
                type: mimeType
              }
            ]);
          };

          img.onerror = function() {
            callback([
              {
                src: imgUrl,
                sizes: '512x512',
                type: 'image/jpeg'
              }
            ]);
          };

          img.src = imgUrl;
        }

        // Hàm giả lập Server Request
        function simulateServerRequest(action, payload) {
          return new Promise((resolve, reject) => {
            setTimeout(() => {
              if (action === "GET_MUSIC_DATA") {
                resolve(musicData);
              } else if (action === "ADD_TO_QUEUE") {
                resolve({ success: true, message: "Đã thêm vào server queue thành công", track: payload });
              } else if (action === "UPDATE_DURATION") {
                resolve({ success: true, message: "Cập nhật duration thành công", data: payload });
              } else if (action === "CREATE_PLAYLIST") {
                console.log("Đã gửi dữ liệu tạo playlist mới lên máy chủ:", payload);
                resolve({ success: true, message: "Tạo playlist mới trên server thành công", playlist: payload });
              } else {
                reject(new Error("Hành động không hợp lệ trên server!"));
              }
            }, 300);
          });
        }

        // ==================== CACHE TEMPLATE VÀ XÓA KHỎI DOM ====================
        function getAndRemoveTemplate(id) {
          const el = document.getElementById(id);
          if (el) {
            const templateClone = el; 
            el.remove();
            return templateClone;
          }
          return null;
        }

        const trackTemplate = getAndRemoveTemplate('track-item-template');
        const popupCardTemplate = getAndRemoveTemplate('popup-playlist-card-template');
        const popupSongTemplate = getAndRemoveTemplate('popup-song-template');
        const queueTemplate = getAndRemoveTemplate('queue-item-template');
        // =========================================================================

        const playlistsContainer = document.getElementById('playlistsContainer');
        const popupPlaylistsList = document.getElementById('popupPlaylistsList');
        const playlistTitleName = document.getElementById('playlist-title-name');
        const playlistCount = document.getElementById('playlist-count');

        const playPauseBtn = document.getElementById('play-pause-btn');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const shuffleBtn = document.getElementById('shuffle-btn');
        const repeatBtn = document.getElementById('repeat-btn');
        const progressBar = document.getElementById('progress-bar');
        const currentTimeEl = document.getElementById('current-time');
        const durationEl = document.getElementById('duration');

        function updatePlayPauseIcon(playing) {
          if (playing) {
            playPauseBtn.classList.remove('fa-play');
            playPauseBtn.classList.add('fa-pause');
          } else {
            playPauseBtn.classList.remove('fa-pause');
            playPauseBtn.classList.add('fa-play');
          }
        }

        function updateMediaSession(track) {
          if ('mediaSession' in navigator) {
            getDynamicArtMetadata(track.art, (artworks) => {
              navigator.mediaSession.metadata = new MediaMetadata({
                title: track.title,
                artist: track.artist,
                album: "Trang Nghe Nhạc Đa Playlist",
                artwork: artworks
              });
            });
          }
        }

        if ('mediaSession' in navigator) {
          navigator.mediaSession.setActionHandler('play', () => {
            audioElement.play().then(() => {
              isPlaying = true;
              updatePlayPauseIcon(true);
            }).catch(err => console.log("MediaSession play error:", err));
          });

          navigator.mediaSession.setActionHandler('pause', () => {
            audioElement.pause();
            isPlaying = false;
            updatePlayPauseIcon(false);
          });

          navigator.mediaSession.setActionHandler('previoustrack', () => {
            prevBtn.click();
          });

          navigator.mediaSession.setActionHandler('nexttrack', () => {
            nextBtn.click();
          });

          navigator.mediaSession.setActionHandler('seekto', (details) => {
            if (details.seekTime && audioElement.duration) {
              audioElement.currentTime = details.seekTime;
            }
          });
        }

        function updatePlayer(track, playOnLoad = true) {
          document.getElementById('current-art').src = getTrackArtUrl(track.art);
          document.getElementById('current-title').textContent = track.title;
          document.getElementById('current-artist').textContent = track.artist;
          
          if (track.duration) {
            durationEl.textContent = track.duration;
          } else {
            durationEl.textContent = "0:00";
          }
          
          audioElement.src = track.url || "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3";
          updateMediaSession(track);
          
          if (playOnLoad) {
            audioElement.play().then(() => {
              isPlaying = true;
              updatePlayPauseIcon(true);
            }).catch(err => console.log("Auto-play blocked:", err));
          }
        }

        audioElement.addEventListener('loadedmetadata', () => {
          const tracks = getActivePlaylistTracks();
          const currentTrack = tracks[currentTrackIndex];
          if (currentTrack && (!currentTrack.duration || currentTrack.duration === "")) {
            const totalSeconds = Math.round(audioElement.duration);
            const formatted = formatTime(audioElement.duration);
            
            currentTrack.duration = formatted; 
            durationEl.textContent = formatted;

            simulateServerRequest("UPDATE_DURATION", {
              id: currentTrack.id || "unknown_id",
              duration: totalSeconds
            }).catch(err => console.error(err));

            const activeTracksDiv = document.getElementById(currentActivePlaylistId);
            if (activeTracksDiv) {
              const item = activeTracksDiv.querySelectorAll('.track-item')[currentTrackIndex];
              if (item) {
                item.querySelector('.track-duration').textContent = formatted;
              }
            }
          }
        });

        playPauseBtn.addEventListener('click', () => {
          if (isPlaying) {
            audioElement.pause();
            isPlaying = false;
            updatePlayPauseIcon(false);
          } else {
            audioElement.play().then(() => {
              isPlaying = true;
              updatePlayPauseIcon(true);
            }).catch(err => console.log("Play error:", err));
          }
        });

        audioElement.addEventListener('timeupdate', () => {
          if (audioElement.duration) {
            const progressPercent = (audioElement.currentTime / audioElement.duration) * 100;
            progressBar.value = progressPercent;
            currentTimeEl.textContent = formatTime(audioElement.currentTime);

            if ('mediaSession' in navigator && 'setPositionState' in navigator.mediaSession) {
              try {
                navigator.mediaSession.setPositionState({
                  duration: audioElement.duration,
                  playbackRate: audioElement.playbackRate,
                  position: audioElement.currentTime
                });
              } catch (e) {}
            }
          }
        });

        progressBar.addEventListener('input', () => {
          if (audioElement.duration) {
            audioElement.currentTime = (progressBar.value / 100) * audioElement.duration;
          }
        });

        function formatTime(seconds) {
          const minutes = Math.floor(seconds / 60);
          const secs = Math.floor(seconds % 60);
          return minutes.toString() + ":" + (secs < 10 ? "0" : "") + secs.toString();
        }

        function getActivePlaylistTracks() {
          const currentPlaylist = musicData.find(p => p.id === currentActivePlaylistId);
          return currentPlaylist ? currentPlaylist.tracks : [];
        }

        nextBtn.addEventListener('click', () => {
          const tracks = getActivePlaylistTracks();
          if (tracks.length === 0) return;

          if (isShuffle) {
            currentTrackIndex = Math.floor(Math.random() * tracks.length);
          } else {
            currentTrackIndex = (currentTrackIndex + 1) % tracks.length;
          }
          playTrackByIndex(currentTrackIndex);
        });

        prevBtn.addEventListener('click', () => {
          const tracks = getActivePlaylistTracks();
          if (tracks.length === 0) return;

          currentTrackIndex = (currentTrackIndex - 1 + tracks.length) % tracks.length;
          playTrackByIndex(currentTrackIndex);
        });

        function playTrackByIndex(index) {
          const tracks = getActivePlaylistTracks();
          if (tracks[index]) {
            const track = tracks[index];
            currentTrackIndex = index;
            updatePlayer(track, true);
            
            const activeTracksDiv = document.getElementById(currentActivePlaylistId);
            if (activeTracksDiv) {
              const trackItems = activeTracksDiv.querySelectorAll('.track-item');
              trackItems.forEach((item, idx) => {
                if (idx === index) item.classList.add('active');
                else item.classList.remove('active');
              });
            }
          }
        }

        audioElement.addEventListener('ended', () => {
          if (isRepeat) {
            audioElement.currentTime = 0;
            audioElement.play();
          } else {
            nextBtn.click();
          }
        });

        shuffleBtn.addEventListener('click', () => {
          isShuffle = !isShuffle;
          shuffleBtn.classList.toggle('is-active', isShuffle);
        });

        repeatBtn.addEventListener('click', () => {
          isRepeat = !isRepeat;
          repeatBtn.classList.toggle('is-active', isRepeat);
        });

        function switchPlaylist(playlistId, playlistName) {
          currentActivePlaylistId = playlistId;
          currentTrackIndex = 0;
          document.querySelectorAll('.playlist-tracks').forEach(el => el.classList.remove('active'));
          const targetPlaylist = document.getElementById(playlistId);
          if (targetPlaylist) {
            targetPlaylist.classList.add('active');
          }
          const found = musicData.find(p => p.id === playlistId);
          if (found) {
            playlistTitleName.textContent = playlistName;
            playlistCount.textContent = found.tracks.length + " bài hát";
          }
        }

        document.getElementById('playEntirePlaylistBtn').addEventListener('click', () => {
          const currentPlaylist = musicData.find(p => p.id === currentActivePlaylistId);
          if (currentPlaylist && currentPlaylist.tracks.length > 0) {
            playTrackByIndex(0);
          }
        });

        // ==================== XỬ LÝ HÀNG ĐỢI (QUEUE) ====================
        let queueListArray = [];
        const queuePopup = document.getElementById('queuePopup');
        const queueListContainer = document.getElementById('queueList');
        const queueCountText = document.getElementById('queueCountText');
        const playQueueBtn = document.getElementById('playQueueBtn');

        function addToQueue(track, btnElement) {
          simulateServerRequest("ADD_TO_QUEUE", track).then(response => {
            console.log(response.message);
            queueListArray.push(track);
            renderQueue();
            queuePopup.classList.add('show');
          }).catch(error => console.error(error));
        }

        function renderQueue() {
          while (queueListContainer.firstElementChild) {
            queueListContainer.firstElementChild.remove();
          }

          queueCountText.textContent = "Đã thêm " + queueListArray.length + " bài hát";
          queueListArray.forEach((track, index) => {
            const clone = queueTemplate.content.cloneNode(true);
            clone.querySelector('.qi-thumb').src = getTrackArtUrl(track.art);
            clone.querySelector('.qi-title').textContent = track.title;
            clone.querySelector('.qi-artist').textContent = track.artist;
            
            clone.querySelector('.queue-item-remove').addEventListener('click', () => {
              queueListArray.splice(index, 1);
              renderQueue();
              if (queueListArray.length === 0) queuePopup.classList.remove('show');
            });
            queueListContainer.appendChild(clone);
          });
        }

        playQueueBtn.addEventListener('click', () => {
          if (queueListArray.length === 0) return;

          const queuePlaylistId = "playlist-queue-temp";
          let existingQueuePlaylist = musicData.find(p => p.id === queuePlaylistId);

          if (existingQueuePlaylist) {
            existingQueuePlaylist.tracks = [...queueListArray];
          } else {
            musicData.unshift({
              id: queuePlaylistId,
              name: "Danh Sách Chờ",
              tracks: [...queueListArray]
            });
          }

          renderAppStructureOnly();
          switchPlaylist(queuePlaylistId, "Danh Sách Chờ");
          playTrackByIndex(0);
          queuePopup.classList.remove('show');
        });

        // ==================== XỬ LÝ NÚT LƯU THÀNH PLAYLIST ====================
        const savePlaylistBtn = document.getElementById('savePlaylistBtn');
        if (savePlaylistBtn) {
          savePlaylistBtn.addEventListener('click', () => {
            if (queueListArray.length === 0) {
              alert("Hàng đợi đang trống, không thể lưu playlist!");
              return;
            }

            const playlistNameInput = prompt("Nhập tên cho playlist mới của bạn:", "Playlist Yêu Thích Mới");
            if (!playlistNameInput || playlistNameInput.trim() === "") {
              return;
            }

            const newPlaylistId = "playlist_" + Date.now();
            const newPlaylistPayload = {
              id: newPlaylistId,
              name: playlistNameInput.trim(),
              tracks: [...queueListArray]
            };

            simulateServerRequest("CREATE_PLAYLIST", newPlaylistPayload).then(response => {
              console.log(response.message);
              musicData.push(newPlaylistPayload);
              renderAppStructureOnly();
              switchPlaylist(newPlaylistId, newPlaylistPayload.name);
              queuePopup.classList.remove('show');
              alert(`Đã tạo và lưu thành công playlist "${newPlaylistPayload.name}"!`);
            }).catch(err => {
              console.error("Lỗi khi tạo playlist lên server:", err);
            });
          });
        }
        // ===================================================================

        document.getElementById('closeQueueBtn').addEventListener('click', () => {
          queuePopup.classList.remove('show');
        });

        function renderAppStructureOnly() {
          while (playlistsContainer.firstElementChild) {
            playlistsContainer.firstElementChild.remove();
          }

          musicData.forEach((playlist) => {
            const tracksDiv = document.createElement('div');
            tracksDiv.classList.add('playlist-tracks');
            tracksDiv.id = playlist.id;
            if (playlist.id === currentActivePlaylistId) tracksDiv.classList.add('active');

            playlist.tracks.forEach((track, tIndex) => {
              const clone = trackTemplate.content.cloneNode(true);
              const item = clone.querySelector('.track-item');
              
              if (playlist.id === currentActivePlaylistId && tIndex === currentTrackIndex) {
                item.classList.add('active');
              }

              item.querySelector('.track-thumb').src = getTrackArtUrl(track.art);
              item.querySelector('.track-title').textContent = track.title;
              item.querySelector('.track-artist').textContent = track.artist;
              item.querySelector('.track-duration').textContent = track.duration || "--:--";

              item.addEventListener('click', () => {
                tracksDiv.querySelectorAll('.track-item').forEach(i => i.classList.remove('active'));
                item.classList.add('active');
                currentTrackIndex = tIndex;
                updatePlayer(track, true);
              });

              const addBtn = item.querySelector('.add-to-queue-btn');
              if (addBtn) {
                addBtn.addEventListener('click', (e) => {
                  e.stopPropagation();
                  addToQueue(track, addBtn);
                });
              }
              tracksDiv.appendChild(clone);
            });
            playlistsContainer.appendChild(tracksDiv);
          });
        }

        function renderApp() {
          simulateServerRequest("GET_MUSIC_DATA").then(data => {
            musicData = data;
            renderPlaylistCards(musicData);
            renderAppStructureOnly();

            if (musicData.length > 0 && musicData[0].tracks.length > 0) {
              playlistTitleName.textContent = musicData[0].name;
              playlistCount.textContent = musicData[0].tracks.length + " bài hát";
              updatePlayer(musicData[0].tracks[0], false);
            }
          });
        }

        function renderPlaylistCards(data) {
          while (popupPlaylistsList.firstElementChild) {
            popupPlaylistsList.firstElementChild.remove();
          }

          document.getElementById('popupMainTitle').textContent = "Danh sách Playlist của bạn";
          document.getElementById('popupBackBtn').style.display = 'none';

          data.forEach((playlist) => {
            const cardClone = popupCardTemplate.content.cloneNode(true);
            const card = cardClone.querySelector('.popup-playlist-card');
            card.querySelector('.popup-pl-name').textContent = playlist.name;
            card.querySelector('.popup-pl-count').textContent = playlist.tracks.length + " bài hát";
            card.querySelector('.popup-play-btn').addEventListener('click', (e) => {
              e.stopPropagation();
              switchPlaylist(playlist.id, playlist.name);
              if (playlist.tracks.length > 0) {
                playTrackByIndex(0);
              }
              document.getElementById('allPlaylistsPopup').classList.remove('show');
            });
            card.querySelector('.popup-info-btn').addEventListener('click', (e) => {
              e.stopPropagation();
              renderPopupSongs(playlist);
            });
            card.addEventListener('click', () => {
              switchPlaylist(playlist.id, playlist.name);
              document.getElementById('allPlaylistsPopup').classList.remove('show');
            });
            popupPlaylistsList.appendChild(cardClone);
          });
        }

        function renderPopupSongs(playlist) {
          document.getElementById('popupMainTitle').textContent = playlist.name;
          document.getElementById('popupBackBtn').style.display = 'block';
          
          while (popupPlaylistsList.firstElementChild) {
            popupPlaylistsList.firstElementChild.remove();
          }

          playlist.tracks.forEach((track, idx) => {
            const songClone = popupSongTemplate.content.cloneNode(true);
            songClone.querySelector('.psi-thumb').src = getTrackArtUrl(track.art);
            songClone.querySelector('.psi-title').textContent = track.title;
            songClone.querySelector('.psi-artist').textContent = track.artist;
            songClone.querySelector('.psi-duration').textContent = track.duration || "--:--";

            // Xử lý sự kiện phát bài hát từ popup song
            songClone.querySelector('.popup-song-play').addEventListener('click', (e) => {
              e.stopPropagation();
              switchPlaylist(playlist.id, playlist.name);
              playTrackByIndex(idx);
              document.getElementById('allPlaylistsPopup').classList.remove('show');
            });

            // THÊM MỚI: Xử lý sự kiện nút "Thêm vào danh sách chờ" trong popup-song-template
            const addQueueBtn = songClone.querySelector('.add-to-queue-btn');
            if (addQueueBtn) {
              addQueueBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                addToQueue(track, addQueueBtn);
                // Tùy chọn: Đóng popup khi thêm xong hoặc giữ nguyên tùy trải nghiệm của bạn
                // document.getElementById('allPlaylistsPopup').classList.remove('show');
              });
            }

            popupPlaylistsList.appendChild(songClone);
          });
        }

        document.getElementById('popupBackBtn').addEventListener('click', () => {
          renderPlaylistCards(musicData);
        });

        const allPlaylistsPopup = document.getElementById('allPlaylistsPopup');
        document.getElementById('openPlaylistPopup').addEventListener('click', () => {
          renderPlaylistCards(musicData);
          allPlaylistsPopup.classList.add('show');
        });

        document.getElementById('closePlaylistPopup').addEventListener('click', () => {
          allPlaylistsPopup.classList.remove('show');
        });

        allPlaylistsPopup.addEventListener('click', (e) => {
          if (e.target === allPlaylistsPopup) {
            allPlaylistsPopup.classList.remove('show');
          }
        });
        - if is_admin
          const openAddSongBtn = document.getElementById('openAddSongPopupBtn');
          const addSongTemplate = document.getElementById('add-song-popup-template');

          openAddSongBtn.addEventListener('click', () => {
            // Clone nội dung từ template vào DOM
            const popupNode = addSongTemplate.content.cloneNode(true);
            document.body.appendChild(popupNode);

            const addSongPopupModal = document.getElementById('addSongPopupModal');
            const closeAddSongPopup = document.getElementById('closeAddSongPopup');
            const addSongForm = document.getElementById('addSongForm');
            const inputSongFile = document.getElementById('inputSongFile');
            const inputSongTitle = document.getElementById('inputSongTitle');
            const inputSongArtist = document.getElementById('inputSongArtist');

            // Tự động điền tên bài hát và nghệ sĩ dựa theo tên file nếu người dùng chọn file trước
            inputSongFile.addEventListener('change', (e) => {
              const file = e.target.files[0];
              if (file) {
                // Lấy tên file làm tên bài hát (bỏ phần mở rộng .mp3, .wav...)
                const fileNameWithoutExt = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
                if (!inputSongTitle.value) {
                  inputSongTitle.value = fileNameWithoutExt;
                }
                if (!inputSongArtist.value) {
                  inputSongArtist.value = "Unknown Artist";
                }
              }
            });

            // Hiển thị popup hiệu ứng mờ dần
            setTimeout(() => {
              addSongPopupModal.classList.add('show');
            }, 10);

            const removePopup = () => {
              addSongPopupModal.classList.remove('show');
              setTimeout(() => {
                addSongPopupModal.remove(); // Xóa khỏi DOM sau khi đóng
              }, 300);
            };

            closeAddSongPopup.addEventListener('click', removePopup);
            addSongPopupModal.addEventListener('click', (e) => {
              if (e.target === addSongPopupModal) {
                removePopup();
              }
            });

            // Xử lý submit thêm bài hát
            addSongForm.addEventListener('submit', (e) => {
              e.preventDefault();
              const title = inputSongTitle.value.trim();
              const artist = inputSongArtist.value.trim();
              const art = document.getElementById('inputSongArt').value.trim() || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=96&auto=format&fit=crop&q=60';
              const fileInput = inputSongFile.files[0];
              const urlInput = document.getElementById('inputSongUrl').value.trim();

              // Kiểm tra xem người dùng chọn file hay nhập URL
              let songUrl = "";
              if (fileInput) {
                // Tạo local URL từ file máy tính
                songUrl = URL.createObjectURL(fileInput);
              } else if (urlInput) {
                songUrl = urlInput;
              } else {
                alert("Vui lòng chọn một tập tin nhạc từ máy hoặc nhập đường dẫn URL!");
                return;
              }

              // Xác định playlist mục tiêu
              let targetPlaylist = null;
              if (typeof currentPlaylistId !== 'undefined') {
                targetPlaylist = musicData.find(pl => pl.id === currentPlaylistId);
              }
              if (!targetPlaylist && musicData.length > 0) {
                targetPlaylist = musicData[0];
              }

              if (targetPlaylist) {
                const newTrack = {
                  id: "song_hash_" + Date.now(),
                  title,
                  artist,
                  duration: "3:30",
                  art,
                  url: songUrl
                };
                targetPlaylist.tracks.push(newTrack);
                
                // Render lại giao diện danh sách bài hát nếu đang mở playlist đó
                if (typeof currentPlaylistId !== 'undefined' && typeof renderPlaylistTracks === 'function') {
                  renderPlaylistTracks(currentPlaylistId);
                }
                
                alert("Thêm bài hát thành công!");
                removePopup();
              } else {
                alert("Không tìm thấy playlist để thêm bài hát!");
              }
            });
          });
        // Khởi chạy ứng dụng
        renderApp();
      })();
